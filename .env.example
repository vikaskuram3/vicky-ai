# VICKY AI VIDEO STUDIO - Environment Configuration
# Brand: VICKY AI - "ONE PROMPT. ONE STORY. ONE COMPLETE MOVIE."
VICKY_SITE_URL=https://vickyai.com

# Server Port & Environment
PORT=3000
NODE_ENV=production

# Supabase Authentication (Part 4)
# Insert your Supabase Project URL and Anon Public Key from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Python AI Backend Service URL (if running backend/app.py on dedicated GPU worker)
BACKEND_URL=http://127.0.0.1:8000

# Open-Source ComfyUI Endpoint (Optional: Connect to RunPod / Modal / Local ComfyUI)
COMFYUI_HOST=127.0.0.1:8188
COMFYUI_ENABLED=false

# Hardware Acceleration (Set to true when running on CUDA-enabled GPU servers)
USE_GPU=false

# Default AI Video Model (wan-2.1, svd-xt, animatediff, ffmpeg-procedural)
DEFAULT_MODEL=ffmpeg-procedural

# Google Search Console Verification Code
GOOGLE_SITE_VERIFICATION=google-search-console-verification-token-placeholder

# Storage Directory for Rendered Video Files & Projects
STORAGE_DIR=./data/outputs

# Security Secret for User Authentication Tokens
JWT_SECRET=vickyai_production_secure_token_change_this_98234
