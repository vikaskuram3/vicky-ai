# ==========================================
# Narasimha PG Hostel Manager SaaS v3.0
# Environment Configuration Template
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Timezone Setting (Critical for Rent Reminders)
TZ=Asia/Kolkata

# Supabase PostgreSQL Configuration (Optional - for cloud database sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Messaging Gateway (Optional - for live WhatsApp & SMS delivery)
# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token

# Twilio SMS Gateway
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Test Mode (When true, simulates messages in database logs without charging API fees)
MESSAGING_TEST_MODE=true
